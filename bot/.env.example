# Telegram Bot — get from @BotFather
TELEGRAM_BOT_TOKEN=

# Authorized chat IDs (comma-separated). Bot ignores messages from other users.
# Find your chat ID by messaging the bot and checking /api/whoami
TELEGRAM_ALLOWED_CHAT_IDS=

# Gemini API key — get from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google Sheets target
SPREADSHEET_ID=1hV9zTIMyX3wlULkWAYN_-nBeNeM6adfL0Zz6MIvwFXE

# Service account JSON (the whole content as a single line, or path to file when running locally)
# On Vercel: paste the JSON content as an env var
GOOGLE_SERVICE_ACCOUNT_JSON=
